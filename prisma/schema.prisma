generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  sessions         Session[]
  planner          Planner?
  garminConnection GarminConnection?
  garminWorkouts   GarminWorkout[]
  stravaConnection StravaConnection?
  stravaActivities StravaActivity[]
  runningAnalyticsSettings RunningAnalyticsSettings?
}

/// Sign-in methods linked to a user. Provider OAuth tokens are not stored.
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Per-email limits for sign-in code requests and failed code entries.
model EmailSignInLimit {
  email          String   @id
  windowStart    DateTime
  sendCount      Int      @default(0)
  failedAttempts Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model Planner {
  userId    String   @id
  /// Planner JSON, validated with parsePlanner on read and write.
  data      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GarminConnection {
  userId         String   @id
  /// HMAC of the Garmin user ID. Unique: a Garmin account links to one Run Week account.
  garminUserKey  String   @unique
  /// AES-256-GCM sealed Garmin OAuth tokens.
  tokens         String
  consentVersion String
  consentAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GarminWorkout {
  id        String   @id @default(cuid())
  userId    String
  /// Scheduled date, YYYY-MM-DD. One Run Week workout per day.
  date      String
  workoutId BigInt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Website-only activity ingestion. OAuth tokens never leave server modules.
model StravaConnection {
  userId         String   @id
  athleteKey     String   @unique
  tokens         String
  consentVersion String
  consentAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  syncActive     Boolean  @default(true)
  syncPage       Int      @default(1)
  syncAfter      Int      @default(0)
  syncBefore     Int
  lastSyncedAt   DateTime?
  syncHistory    Json     @default("[]")
  elevationVersion Int    @default(0)
  generation     String   @default(uuid())
  jobs           StravaSyncJob[]
  retryAt        DateTime?
  leaseId        String?
  leaseUntil     DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StravaSyncJob {
  id            String   @id @default(uuid())
  userId        String
  generation    String
  kind          String
  start         String
  end           String
  remaining     Json     @default("[]")
  before        Int
  page          Int      @default(1)
  phase         String   @default("summaries")
  status        String   @default("queued")
  version       Int      @default(1)
  publishedAt   DateTime?
  retryAt       DateTime?
  errorCode     String?
  summaries     Int      @default(0)
  recordings    Int      @default(0)
  /// Targeted webhook outbox. Null for existing paginated imports.
  sourceId      String?
  webhookKey    String?  @unique
  webhookEventTime Int?
  webhookFingerprint String?
  /// Authoritative absence/non-running result fences later summary imports.
  webhookDeleted Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  connection    StravaConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([userId, createdAt])
  @@index([userId, sourceId])
}

model StravaSyncQuota {
  id         String   @id
  nextCallAt DateTime
}

model StravaActivity {
  id             String   @id @default(cuid())
  userId         String
  sourceId       String
  name           String
  sport          String
  startedAt      DateTime
  localDate      String
  distanceMeters Float
  movingSeconds  Int
  elapsedSeconds Int
  averageHr      Float?
  maxHr          Float?
  elevationGainMeters Float?
  elevationStreamState String @default("pending")
  /// Only time, heartrate, velocity_smooth, distance and altitude; never GPS coordinates.
  streams        Json?
  streamState    String   @default("pending")
  maximalEffort  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@index([userId, localDate])
  @@index([userId, streamState])
  @@index([userId, elevationStreamState])
}

/// Explicitly supplied settings, not inferred physiological thresholds.
model RunningAnalyticsSettings {
  userId       String @id
  zoneBounds   Json
  thresholdBpm Int?
  maxHr        Int?
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
