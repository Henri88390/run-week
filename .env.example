# Garmin Connect integration (optional). Leave empty to hide the Garmin controls.
# Copy to .env.local and fill in the values from the Garmin Connect Developer Program.

# Application consumer key
GARMIN_CLIENT_ID=

# Application consumer secret
GARMIN_CLIENT_SECRET=

# Random string of at least 32 characters, used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GARMIN_SESSION_SECRET=

# Optional: omit both values to use per-process in-memory upload limits.
# Memory limits reset on restarts and are not shared across Vercel instances.
# Create an Upstash Redis database and copy its REST URL and read/write REST token.
# Server-only; never use NEXT_PUBLIC_ names. Use a separate database for development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults to <origin>/api/garmin/callback. Must be registered with Garmin.
GARMIN_REDIRECT_URI=https://run-week.fyi/api/garmin/callback

# Required before users can authorize Garmin. Name every hosting/infrastructure
# processor (including CDN/proxy and managed logging providers) receiving Garmin
# traffic. Shown publicly in the privacy policy and consent page.
PRIVACY_HOSTING_PROVIDER=
