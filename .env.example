# Copy to .env.local and fill in the values.

# --- Database (required) ---
# Local: `docker compose up -d` starts PostgreSQL with these credentials.
# Supabase: DATABASE_URL is the pooled connection (port 6543, ?pgbouncer=true);
# DIRECT_URL is the direct or session connection used for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Accounts (Auth.js) ---
# Random string of at least 32 characters, used to sign auth cookies and hash email codes.
# Generate one with: npx auth secret   (or the node command below)

//prod
# AUTH_SECRET=

# Email sign-in codes through Resend. Without a key outside production, codes are
# printed to the server console. AUTH_EMAIL_FROM must use a domain verified in Resend.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=

# Optional Google sign-in. Leave empty to hide the Google button.
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production behind a proxy that is not Vercel.
# AUTH_TRUST_HOST=true

# --- Garmin Connect (optional) ---
# Leave empty to hide the Garmin controls. Values from the Garmin Connect Developer Program.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Random string of at least 32 characters, used to encrypt the stored Garmin tokens,
# the OAuth authorization cookie and the upload quota keys. Changing it disconnects every account.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GARMIN_SESSION_SECRET=

# Optional. Defaults to <origin>/api/garmin/callback. Must be registered with Garmin.
GARMIN_REDIRECT_URI=
# Required before users can authorize Garmin. Name every hosting/infrastructure
# processor (including the database host, CDN/proxy and managed logging providers).
# Shown publicly in the privacy policy and consent page.
PRIVACY_HOSTING_PROVIDER=

# --- Strava activity dashboards (website only, optional) ---
# Separate from Auth.js sign-in and Garmin workout sending; never NEXT_PUBLIC_*.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Independent random secret, at least 32 characters. No default/fallback is permitted.
# Changing this key requires reconnection and migration of keyed athlete identities.
STRAVA_TOKEN_ENCRYPTION_KEY=
# Register callback domain run-week.fyi with Strava.
STRAVA_REDIRECT_URI=https://run-week.fyi/api/strava/callback
# --- Shared Redis (optional) ---
# Garmin upload limits and the five-minute Strava cache use Docker Redis locally
# and Upstash's REST API when NODE_ENV=production.
# Local: `docker compose up -d redis`, then redis://127.0.0.1:6379.
# REDIS_URL is ignored in production; Upstash variables are ignored locally.
REDIS_URL=redis://127.0.0.1:6379
# Production: copy the HTTPS REST URL and read/write token from an Upstash database.
# Server-only; never NEXT_PUBLIC_*. Disclose Upstash in PRIVACY_HOSTING_PROVIDER.
# Use a separate production database; never reuse development quotas/data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# If the selected backend is unconfigured, Garmin limits use per-process memory and
# the Strava cache is disabled with a warning. Configured failures never fall back.
