# Garmin Connect integration (optional). Leave empty to hide the Garmin controls.
# Copy to .env.local and fill in the values from the Garmin Connect Developer Program.

# Application consumer key
GARMIN_CLIENT_ID=

# Application consumer secret
GARMIN_CLIENT_SECRET=

# Random string of at least 32 characters, used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GARMIN_SESSION_SECRET=

# Optional. Defaults to <origin>/api/garmin/callback. Must be registered with Garmin.
# GARMIN_REDIRECT_URI=http://localhost:3000/api/garmin/callback
